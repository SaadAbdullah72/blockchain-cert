# ========================================================
# Solana Blockchain Certificate Protocol (.env.example)
# ========================================================

# 1. Solana RPC Network Endpoint (Defaults to Public Solana Devnet)
# Public Devnet: https://api.devnet.solana.com
# Custom Helius / QuickNode / Alchemy RPC: https://devnet.helius-rpc.com/?api-key=YOUR_KEY
VITE_SOLANA_RPC_URL=https://api.devnet.solana.com
VITE_SOLANA_NETWORK=devnet

# 2. Deployed Solana Anchor Program ID (Optional custom program)
# Default built-in Program ID:
VITE_SOLANA_PROGRAM_ID=CertChain11111111111111111111111111111111111

# 3. Decentralized IPFS Storage for Metadata (Optional)
# Pinata or Web3.Storage JWT Token for persistent Arweave/IPFS uploads
VITE_PINATA_JWT=

# 4. Issuer Admin Public Address (Optional override)
VITE_ISSUER_PUBLIC_KEY=9xQeWvG816bUx9EPjHmaT23yvVM2ZWbrrpZb9PusVFin
